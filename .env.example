# ===========================================
# DATABASE - Mỗi deployment dùng DB RIÊNG
# ===========================================
# Cách 1: Dùng DATABASE_URL (ưu tiên - cho TiDB Cloud, PlanetScale, AWS RDS...)
# DATABASE_URL=mysql://user:password@host:3306/database_name

# Cách 2: Dùng DB_* (cho MySQL thường)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=drone_flight
# Tuỳ chọn: timeout kết nối MySQL (ms), tránh treo lâu khi deploy
# DB_CONNECT_TIMEOUT_MS=15000

# ===========================================
# AWS DEPLOYMENT - Database riêng cho AWS
# ===========================================
# Trên AWS EC2/ECS: set env trỏ tới MySQL trên RDS hoặc TiDB Cloud
# DATABASE_URL=mysql://aws_user:aws_pass@your-rds-endpoint:3306/drone_flight
# Hoặc:
# DB_HOST=your-rds-endpoint.amazonaws.com
# DB_USER=aws_user
# DB_PASS=aws_pass
# DB_NAME=drone_flight

# ===========================================
# VERCEL DEPLOYMENT - Database riêng cho Vercel
# ===========================================
# Trên Vercel: set env trỏ tới MySQL riêng (PlanetScale, TiDB, RDS...)
# DATABASE_URL=mysql://vercel_user:vercel_pass@your-db-host:3306/drone_flight
# Hoặc:
# DB_HOST=your-vercel-db-host
# DB_USER=vercel_user
# DB_PASS=vercel_pass
# DB_NAME=drone_flight

# ===========================================
# CHUNG
# ===========================================
PORT=5000
NODE_ENV=production
JWT_SECRET=your-super-secret-key-change-in-production

# Admin mặc định (tự tạo khi server khởi động nếu chưa có)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123

# CORS - Origin của FRONTEND (nơi user mở trang)
# AWS frontend: http://35.77.31.225 hoặc http://35.77.31.225:3000
# Vercel frontend: https://flight-report-client.vercel.app
CORS_ORIGINS=http://localhost:5173,https://flight-report-client.vercel.app,http://18.181.46.115/,http://18.181.46.115/:3000

# Mail (Resend)
RESEND_API_KEY=re_xxx
SUPPORT_EMAIL=your@email.com

# Google Maps
API_KEY=your-google-maps-api-key

# J-Payment link方式 (BE trung gian)
JPAYMENT_AID=
# REQUIRED. Server exits on startup if this is empty.
# Long random secret. Put the same value in the J-Payment notify URL:
# - Recommended (many gateways drop a pre-set ?s=): https://<host>/api/payment/callback/SECRET
# - Or, if the gateway keeps the full query: https://<host>/api/payment/callback?s=SECRET
# The browser return URL (/api/payment/return) must NOT be used to confirm payment.
JPAYMENT_CALLBACK_QUERY_SECRET=
# Public backend URL để trả checkoutUrl đầy đủ
BACKEND_PUBLIC_BASE_URL=http://localhost:5000
# URL FE nhận redirect sau thanh toán, dạng: https://fe.example.com/payment
PAYMENT_FRONTEND_RETURN_URL=
# Bảng giá package do BE quyết định (FE không cần gửi amount)
PAYMENT_PRICE_MONTHLY_PERSONAL=1320
PAYMENT_PRICE_MONTHLY_COMPANY=2980
PAYMENT_PRICE_YEARLY_PERSONAL=14520
PAYMENT_PRICE_YEARLY_COMPANY=32780

# Auto renew worker (safe defaults: off)
PAYMENT_AUTO_RENEW_WORKER_ENABLED=false
PAYMENT_AUTO_RENEW_INTERVAL_MS=300000

# Server-side auto-renew for BANK_TRANSFER / FREE (creates next paid period when periodEndAt passes).
# CREDIT_CARD renewals remain J-Payment callback-driven.
PAYMENT_BANK_FREE_AUTO_RENEW_WORKER_ENABLED=false

# Recurring charge (must enable explicitly)
PAYMENT_AUTO_RENEW_ENABLED=false
JPAYMENT_RECURRING_CHARGE_URL=
JPAYMENT_RECURRING_API_KEY=
JPAYMENT_RECURRING_TIMEOUT_MS=10000
# Timeout for gateway.aspx and acsgate.aspx (ms). Falls back to JPAYMENT_RECURRING_TIMEOUT_MS.
# JPAYMENT_GATEWAY_TIMEOUT_MS=10000

# Retry failed J-Payment auto-charge stops (acsgate). On by default.
# Uses payment_orders.renewNextRetryAt (next JST date after a failed stop).
# Set to false to disable. Interval defaults to PAYMENT_AUTO_RENEW_INTERVAL_MS (300000).
# PAYMENT_AUTO_CHARGE_STOP_RETRY_WORKER_ENABLED=true
# PAYMENT_AUTO_CHARGE_STOP_RETRY_INTERVAL_MS=300000


